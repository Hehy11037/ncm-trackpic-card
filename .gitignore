# dependencies / build output
node_modules/
dist/
out/
build/
*.tsbuildinfo

# reconnaissance scratch: unpacked NetEase client bundle (web.pack) used as a
# symbol reference while implementing the CDP bridge. Safe to delete and
# regenerate; never shipped.
.scratch/

# local runtime state
.env
.env.local
*.local

# machine-specific launcher generated by tools/debug-launch.ps1: it embeds an
# absolute path to the local NetEase install, so it must not be shared.
tools/*.lnk

# The maintainer's local notebook.
#
# Deliberately not published: a clone should get the code, the checks, the contracts and the
# chronological record in NOTES.md - not someone else's running scratchpad of rules that may be
# half-rewritten. NOTES.md is the published half and carries the same lessons, so anything worth
# sharing goes there.
MEMORY.md
