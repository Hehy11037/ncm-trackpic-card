# Keep npm's cache and logs inside the workspace.
#
# Reason: the default cache location is under %LOCALAPPDATA%, which the tooling
# shell may not be able to write. Redirecting it here makes `npm install` work
# regardless of shell confinement. See NOTES.md.
#
# Note: an absolute path is used because the environment variable npm_config_cache
# (when set) overrides values from this file, and npm resolves relative paths here
# against the user's home directory rather than this project. If an install still
# fails with EPERM on %LOCALAPPDATA%\npm-cache, pass --cache explicitly:
#
#   npm install --cache "C:\Users\he\Desktop\music_program\.scratch\npm-cache"
cache=C:\Users\he\Desktop\music_program\.scratch\npm-cache
logs-dir=C:\Users\he\Desktop\music_program\.scratch\npm-cache\_logs
audit=false
fund=false
update-notifier=false
